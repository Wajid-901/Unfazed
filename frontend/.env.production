# ============================================================
# PRODUCTION ENVIRONMENT — Frontend
# ============================================================
# These values are used during `vite build` on Render.
# Set them as Environment Variables in the Render dashboard
# (not committed to git with real values).
# ============================================================

# Full URL of your deployed backend API — MUST include /api/v1
VITE_API_URL=https://unfazed-tb0t.onrender.com/api/v1

# Your Razorpay LIVE key (starts with rzp_live_)
VITE_RAZORPAY_KEY=rzp_live_your_key_here
